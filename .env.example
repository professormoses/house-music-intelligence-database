# ─────────────────────────────────────────────────────────────
# House Music Intelligence Database — environment template
# Copy to .env and fill in. Everything except DATABASE_URL and
# SITE_URL is optional for V1 (the seed dataset runs with none).
# ─────────────────────────────────────────────────────────────

# --- Core ---
# Local dev: a SQLite file (zero config). The provider auto-switches via
# scripts/set-db-provider.mjs based on this URL — no manual schema edits.
#   file:...        -> SQLite (local)
#   postgresql://...-> Postgres (Vercel / Neon / Supabase)
DATABASE_URL="file:./dev.db"
# Production (Vercel Postgres / Neon) also injects a direct (non-pooled) URL
# used for `prisma db push`. The Vercel Postgres/Neon integration sets both.
# DATABASE_URL="postgresql://USER:PASS@HOST/db?sslmode=require&pgbouncer=true"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASS@HOST/db?sslmode=require"

# Public canonical origin. Used in sitemaps, llms.txt, citations, JSON-LD.
# On Vercel set this to your deployment URL (e.g. https://artists.yourdomain.com).
SITE_URL="http://localhost:3000"

# Protects /admin and the repopulate/export endpoints. Set a long random string.
ADMIN_TOKEN="change-me-to-a-long-random-string"

# Vercel Cron auth: Vercel sends "Authorization: Bearer <CRON_SECRET>" on
# scheduled runs. Set this so the nightly auto-repopulate is authenticated.
CRON_SECRET="another-long-random-string"

# Link to the companion House Music LA Radar app (shows an "LA Radar" nav link).
LA_RADAR_URL=""

# --- Source connector credentials (all optional for V1) ---
# MusicBrainz needs no key — only a contact string for its User-Agent policy.
MUSICBRAINZ_CONTACT="you@example.com"

# Discogs: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=""

# Spotify Web API: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# YouTube Data API v3: https://console.cloud.google.com
YOUTUBE_API_KEY=""

# Last.fm: https://www.last.fm/api/account/create
LASTFM_API_KEY=""

# Bandsintown app id (public): https://www.artists.bandsintown.com
BANDSINTOWN_APP_ID=""

# Songkick API (request access from Songkick)
SONGKICK_API_KEY=""

# --- Google Sheets export (optional) ---
# Service account JSON path + target spreadsheet id. Share the sheet with the
# service-account email. If unset, exports fall back to local CSV/JSON files.
GOOGLE_SERVICE_ACCOUNT_JSON="./google-service-account.json"
GOOGLE_SHEETS_SPREADSHEET_ID=""

# --- Crawler etiquette ---
CRAWLER_USER_AGENT="HouseMusicIntelligenceDB/1.0 (+https://example.com; contact you@example.com)"
CRAWLER_RATE_LIMIT_MS="1100"

# Data API key — gates bulk CSV/JSON/NDJSON + contact emails (tiered protection).
DATA_API_KEY=""
